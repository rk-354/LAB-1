# ============================================================
# RefinerIQ — Environment Variables
# Copy relevant vars to services/frontend/.env.local
# NEVER commit .env.local or any file with real credentials
# ============================================================

# ── Supabase ──────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<your-anon-key>
SUPABASE_SERVICE_ROLE_KEY=<your-service-role-key>

# ── LLMs ──────────────────────────────────────────────────
# Ollama runs locally — install from https://ollama.com
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_EMBED_MODEL=nomic-embed-text

# Anthropic (fallback LLM) — https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# Gemini (OCR only) — https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AIza...

# Resend (email for auth magic links) — https://resend.com/api-keys
RESEND_API_KEY=re_...

# ── Elasticsearch (Docker) ────────────────────────────────
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_INDEX=refinery_docs

# ── App ───────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
